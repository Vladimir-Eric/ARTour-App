<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/material_dynamic_primary90"
    tools:context=".PocetnaFragment">

    <FrameLayout
        android:id="@+id/frame_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <com.google.android.material.bottomappbar.BottomAppBar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/bottomAppBar"
        android:layout_gravity="bottom"
        android:background="@color/white"
        app:fabCradleMargin="10dp"
        app:fabCradleRoundedCornerRadius="50dp">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/bottomNavigationView"
            android:layout_marginEnd="20dp"
            app:labelVisibilityMode="labeled"
            android:background="@android:color/transparent"
            app:menu="@menu/bottom_menu"/>
    </com.google.android.material.bottomappbar.BottomAppBar>

    <ImageView
        android:id="@+id/info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        app:layout_anchor="@+id/frame_layout"
        app:layout_anchorGravity="end|top"
        app:srcCompat="@android:drawable/ic_dialog_info" />

    <ImageView
        android:id="@+id/properties"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        app:layout_anchor="@+id/frame_layout"
        app:layout_anchorGravity="start|top"
        app:srcCompat="@drawable/baseline_menu_24" />

    <TextView
        android:id="@+id/naslov"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:text="TURISTIČKI VODIČ OPŠTINE MILIĆI"
        android:textSize="25dp"
        android:textStyle="bold"
        app:layout_anchor="@+id/frame_layout"
        app:layout_anchorGravity="center"
        android:translationY="-260dp"/>

    <TextView
        android:id="@+id/kartice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="IZDVOJENE LOKACIJE"
        android:fontFamily="sans-serif-condensed"
        android:textSize="20dp"
        android:textStyle="bold"
        app:layout_anchor="@+id/frame_layout"
        app:layout_anchorGravity="center"
        android:translationY="-180dp"/>

    <androidx.viewpager2.widget.ViewPager2
        android:layout_width="410dp"
        android:layout_height="210dp"
        app:layout_anchor="@+id/frame_layout"
        app:layout_anchorGravity="center"
        android:translationY="-50dp"/>

    <ImageView
        android:id="@+id/ikona1"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_anchor="@+id/frame_layout"
        app:layout_anchorGravity="center"
        app:srcCompat="@drawable/baseline_forest_24"
        android:translationY="120dp"
        android:translationX="-140dp"/>
    <ImageView
        android:id="@+id/ikona2"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_anchor="@+id/frame_layout"
        app:layout_anchorGravity="center"
        app:srcCompat="@drawable/baseline_local_cafe_24"
        android:translationY="120dp"
        android:translationX="-70dp"/>
    <ImageView
        android:id="@+id/ikona3"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_anchor="@+id/frame_layout"
        app:layout_anchorGravity="center"
        app:srcCompat="@drawable/baseline_church_24"
        android:translationY="120dp"
        android:translationX="0dp"/>

    <ImageView
        android:id="@+id/ikona4"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/baseline_hotel_24"
        app:layout_anchor="@+id/frame_layout"
        app:layout_anchorGravity="center"
        android:translationY="120dp"
        android:translationX="70dp"/>

    <ImageView
        android:id="@+id/ikona5"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/baseline_place_24"
        app:layout_anchor="@+id/frame_layout"
        app:layout_anchorGravity="center"
        android:translationY="120dp"
        android:translationX="140dp"/>

    <TextView
        android:id="@+id/kategorije"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="KATEGORIJE"
        android:fontFamily="sans-serif-condensed"
        android:textSize="20dp"
        android:textStyle="bold"
        android:translationY="60dp"
        app:layout_anchor="@+id/frame_layout"
        app:layout_anchorGravity="center" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>