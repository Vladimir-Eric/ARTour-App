<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pozadina"
    tools:context=".PocetnaFragment">


    <ImageView
        android:id="@+id/menu"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_anchorGravity="start|end"
        android:layout_marginTop="5dp"
        app:srcCompat="@drawable/baseline_menu_24" />

    <TextView
        android:id="@+id/glavniNaslov"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:fontFamily="sans-serif-condensed"
        android:textSize="40dp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:text="ARTour" />

    <ImageView
        android:id="@+id/ikonica"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="end|top"
        android:layout_marginTop="5dp"
        app:srcCompat="@android:drawable/btn_star" />

    <TextView
        android:id="@+id/naslov"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:text="TURISTIČKI VODIČ OPŠTINE MILIĆI"
        android:textSize="15dp"
        android:textStyle="bold"
        android:layout_marginTop="50dp"
        android:layout_gravity="center|top"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_gravity="center|top"
        android:layout_marginTop="90dp"

        android:foregroundGravity="center"
        app:cardBackgroundColor="#00FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/weatherIconImageView"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_below="@id/windSpeedTextView"
                android:layout_gravity="center|left"
                android:layout_marginLeft="20dp"
                android:contentDescription="TODO" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_gravity="center|right"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center|center_horizontal|center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/temperatureTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:padding="2dp"
                        android:text="Temperature: N/A"
                        android:textColor="@color/black"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/humidityTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/temperatureTextView"
                        android:layout_gravity="center_horizontal"
                        android:padding="2dp"
                        android:text="Humidity: N/A"
                        android:textColor="@color/black"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/weatherInfoTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/humidityTextView"
                        android:layout_gravity="center_horizontal"
                        android:padding="2dp"
                        android:text="Weather: N/A"
                        android:textColor="@color/black"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/windSpeedTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/weatherInfoTextView"
                        android:layout_gravity="center_horizontal"
                        android:padding="2dp"
                        android:text="Wind Speed: N/A"
                        android:textColor="@color/black"
                        android:textSize="15sp" />
                </LinearLayout>

            </LinearLayout>


        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/kategorije"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:text="KATEGORIJE"
        android:textSize="20dp"
        android:textStyle="bold"
        android:translationY="-125dp"
        app:layout_anchor="@+id/frame_layout"
        app:layout_anchorGravity="center" />

    <FrameLayout
        android:id="@+id/frame1"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:layout_anchor="@id/frame_layout"
        app:layout_anchorGravity="center"
        android:translationX="-140dp"
        android:translationY="-65dp">

        <ImageButton
            android:id="@+id/dugme1"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/round_btn"
            android:scaleType="centerInside"
            android:src="@drawable/baseline_forest_24"
            app:layout_anchor="@id/frame_layout"
            app:layout_anchorGravity="center" />
        <TextView
            android:id="@+id/tekst1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="37dp"
            android:fontFamily="sans-serif-condensed"
            android:text="Priroda"
            android:textStyle="bold"
            app:layout_anchor="@+id/frame1"
            app:layout_anchorGravity="bottom|center" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/frame2"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:layout_anchor="@id/frame_layout"
        app:layout_anchorGravity="center"
        android:translationX="-70dp"
        android:translationY="-65dp">

        <ImageButton
            android:id="@+id/dugme2"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/round_btn"
            android:scaleType="centerInside"
            android:src="@drawable/baseline_local_cafe_24"
            app:layout_anchor="@id/frame_layout"
            app:layout_anchorGravity="center" />

        <TextView
            android:id="@+id/tekst2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="37dp"
            android:fontFamily="sans-serif-condensed"
            android:text="Objekti"
            android:textStyle="bold"
            app:layout_anchor="@+id/frame1"
            app:layout_anchorGravity="bottom|center" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/frame3"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:layout_anchor="@id/frame_layout"
        app:layout_anchorGravity="center"
        android:translationX="0dp"
        android:translationY="-65dp">

        <ImageButton
            android:id="@+id/dugme3"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/round_btn"
            android:scaleType="centerInside"
            android:src="@drawable/baseline_church_24"
            app:layout_anchor="@id/frame_layout"
            app:layout_anchorGravity="center" />

        <TextView
            android:id="@+id/tekst3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="37dp"
            android:fontFamily="sans-serif-condensed"
            android:text="Spomenici"
            android:textStyle="bold"
            app:layout_anchor="@+id/frame1"
            app:layout_anchorGravity="bottom|center" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/frame4"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:layout_anchor="@id/frame_layout"
        app:layout_anchorGravity="center"
        android:translationX="70dp"
        android:translationY="-65dp">

        <ImageButton
            android:id="@+id/dugme4"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/round_btn"
            android:scaleType="centerInside"
            android:src="@drawable/baseline_hotel_24"
            app:layout_anchor="@id/frame_layout"
            app:layout_anchorGravity="center" />

        <TextView
            android:id="@+id/tekst4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="37dp"
            android:fontFamily="sans-serif-condensed"
            android:text="Objekti"
            android:textStyle="bold"
            app:layout_anchor="@+id/frame1"
            app:layout_anchorGravity="bottom|center" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/frame5"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:layout_anchor="@id/frame_layout"
        app:layout_anchorGravity="center"
        android:translationX="140dp"
        android:translationY="-65dp">

        <ImageButton
            android:id="@+id/dugme5"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/round_btn"
            android:scaleType="centerInside"
            android:src="@drawable/baseline_place_24"
            app:layout_anchor="@id/frame_layout"
            app:layout_anchorGravity="center" />

        <TextView
            android:id="@+id/tekst5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="37dp"
            android:fontFamily="sans-serif-condensed"
            android:text="Objekti"
            android:textStyle="bold"
            app:layout_anchor="@+id/frame1"
            app:layout_anchorGravity="bottom|center" />
    </FrameLayout>

    <TextView
        android:id="@+id/kartice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:text="IZDVOJENE LOKACIJE"
        android:textSize="20dp"
        android:textStyle="bold"
        android:translationY="10dp"
        app:layout_anchor="@+id/frame_layout"
        app:layout_anchorGravity="center" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:translationY="140dp"
        app:layout_anchor="@+id/frame_layout"
        app:layout_anchorGravity="center" />

    <FrameLayout
        android:id="@+id/frame_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />


    <com.google.android.material.bottomappbar.BottomAppBar
        android:id="@+id/bottomAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@android:color/white"
        android:visibility="invisible"
        app:fabCradleMargin="10dp"
        app:fabCradleRoundedCornerRadius="50dp">

    </com.google.android.material.bottomappbar.BottomAppBar>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_vertical"
        android:layout_marginHorizontal="40dp"
        android:background="@color/white"
        android:visibility="invisible"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>