<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PocetnaFragment"
    android:background="?attr/fragment_pozadina">


    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="120dp"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="?attr/naslovna_linija"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal"
                android:elevation="8dp"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="50dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1">

                    <ImageButton
                        android:id="@+id/menu"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center|left"
                        android:layout_marginStart="10dp"
                        android:background="#00FFFFFF"
                        android:contentDescription="@string/opis_dugmeta"
                        app:srcCompat="@drawable/baseline_menu_24"
                        app:tint="@color/white"
                        tools:ignore="RtlHardcoded" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/Naslov"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:autoSizeMaxTextSize="24sp"
                        android:autoSizeMinTextSize="20sp"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="@font/carossoftbold"
                        android:gravity="center"
                        android:text="@string/artour1"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/naslov"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center|top"
                        android:layout_marginBottom="5dp"
                        android:autoSizeMaxTextSize="15sp"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="@font/carossoft"
                        android:gravity="center"
                        android:text="@string/turisticki_vodic"
                        android:textColor="@color/white"
                        android:textSize="15sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ikonica"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center|right"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:src="@drawable/artour_logo_white"
                    android:contentDescription="@string/opis_slike"
                    tools:ignore="RtlHardcoded" />

            </LinearLayout>

            <View
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom"
                android:background="?android:attr/listDivider" />

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="10dp"
            android:outlineAmbientShadowColor="@android:color/transparent"
            android:translationZ="1dp"
            app:cardBackgroundColor="?attr/kartica_nova"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingVertical="15dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:paddingHorizontal="30dp">

                    <TextView
                        android:id="@+id/trenutnoumilicima"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="20sp"
                        android:autoSizeMinTextSize="14sp"
                        android:fontFamily="@font/carossoft"
                        android:text="@string/trenutno_u_milicima"
                        android:textColor="?attr/heading_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/dan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="right"
                        android:layout_weight="1"
                        android:autoSizeMinTextSize="14sp"
                        android:fontFamily="@font/carossoft"
                        android:foregroundGravity="bottom"
                        android:gravity="bottom|right"
                        android:text="@string/dan"
                        android:textColor="?attr/heading_text"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:ignore="RtlHardcoded" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center|left"
                        android:layout_weight="1"
                        android:gravity="center|left"
                        android:orientation="vertical"
                        tools:ignore="RtlHardcoded">

                        <ImageView
                            android:id="@+id/weatherIconImageView"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:layout_gravity="center|center_horizontal|center_vertical"
                            android:contentDescription="@string/opis_slike" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/temperatureTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal|left"
                            android:autoSizeMaxTextSize="24sp"
                            android:autoSizeTextType="uniform"
                            android:gravity="left"
                            android:text="@string/n_a"
                            android:textColor="?attr/heading_text"
                            android:textSize="24sp"
                            tools:ignore="RtlHardcoded" />

                        <TextView
                            android:id="@+id/weatherInfoTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal|left"
                            android:autoSizeMaxTextSize="16sp"
                            android:autoSizeTextType="uniform"
                            android:gravity="left"
                            android:text="@string/n_a"
                            android:textColor="?attr/heading_text"
                            android:textSize="16sp"
                            tools:ignore="RtlHardcoded" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="60dp"
                        android:layout_gravity="center|right"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        tools:ignore="RtlHardcoded">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="right"
                            android:layout_marginRight="15dp"
                            android:gravity="center|center_horizontal|center_vertical"
                            android:orientation="horizontal"
                            android:padding="2dp"
                            tools:ignore="UseCompoundDrawables">

                            <TextView
                                android:id="@+id/humidityTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="left"
                                android:autoSizeMaxTextSize="15sp"
                                android:autoSizeTextType="uniform"
                                android:gravity="left"
                                android:text="@string/n_a"
                                android:textColor="?attr/heading_text"
                                android:textSize="15sp" />

                            <ImageView
                                android:id="@+id/vlaga"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_gravity="center|right"
                                android:layout_marginLeft="8dp"
                                android:contentDescription="@string/opis_slike"
                                android:src="@drawable/raindrops"
                                app:tint="?attr/slicice" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="right"
                            android:layout_marginRight="15dp"
                            android:gravity="center|center_horizontal|center_vertical"
                            android:orientation="horizontal"
                            tools:ignore="UseCompoundDrawables">

                            <TextView
                                android:id="@+id/windSpeedTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="left"
                                android:autoSizeTextType="uniform"
                                android:gravity="left"
                                android:text="@string/n_a"
                                android:textColor="?attr/heading_text"
                                android:textSize="15sp" />

                            <ImageView
                                android:id="@+id/vjetar"
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_gravity="center|right"
                                android:layout_marginLeft="8dp"
                                android:contentDescription="@string/opis_slike"
                                android:src="@drawable/wind"
                                app:tint="?attr/slicice" />
                        </LinearLayout>

                    </LinearLayout>


                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="10dp"
            android:outlineAmbientShadowColor="@android:color/transparent"
            android:translationZ="1dp"
            app:cardBackgroundColor="?attr/kartica_nova"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingVertical="15dp">

                <TextView
                    android:id="@+id/kategorije"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="30dp"
                    android:autoSizeMaxTextSize="20sp"
                    android:autoSizeMinTextSize="14sp"
                    android:fontFamily="@font/carossoft"
                    android:text="@string/kategorije"
                    android:textColor="?attr/heading_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="10dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <FrameLayout
                        android:id="@+id/frame1"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:translationX="0dp"
                        android:translationY="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            tools:ignore="UselessParent">

                            <ImageButton
                                android:id="@+id/dugme1"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center|top"
                                android:background="@drawable/round_btn"
                                android:backgroundTint="?attr/kategorije_ikonice"
                                android:contentDescription="@string/opis_dugmeta"
                                android:elevation="2dp"
                                android:outlineSpotShadowColor="#00000000"
                                android:padding="5dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/old_monument"
                                app:layout_anchor="@id/frame_layout"
                                app:layout_anchorGravity="center|center_horizontal|center_vertical"
                                app:tint="@color/primarna" />

                            <TextView
                                android:id="@+id/tekst1"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:layout_marginTop="5dp"
                                android:autoSizeMaxTextSize="12sp"
                                android:autoSizeMinTextSize="5sp"
                                android:autoSizePresetSizes="12sp"
                                android:fontFamily="@font/carossoftlight"
                                android:gravity="bottom|center"
                                android:text="@string/spomenici"
                                android:textColor="?attr/heading_text"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                app:layout_anchor="@+id/frame1"
                                app:layout_anchorGravity="center|center_horizontal|center_vertical"
                                tools:ignore="SmallSp" />
                        </LinearLayout>

                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/frame2"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:translationX="0dp"
                        android:translationY="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            tools:ignore="UselessParent">

                            <ImageButton
                                android:id="@+id/dugme2"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center|top"
                                android:background="@drawable/round_btn"
                                android:backgroundTint="?attr/kategorije_ikonice"
                                android:contentDescription="@string/opis_dugmeta"
                                android:elevation="2dp"
                                android:outlineSpotShadowColor="#00000000"
                                android:padding="5dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/church"
                                app:layout_anchor="@id/frame_layout"
                                app:layout_anchorGravity="center|center_horizontal|center_vertical"
                                app:tint="@color/primarna" />

                            <TextView
                                android:id="@+id/tekst2"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:layout_marginTop="5dp"
                                android:autoSizeMaxTextSize="12sp"
                                android:autoSizeMinTextSize="5sp"
                                android:autoSizePresetSizes="12sp"
                                android:fontFamily="@font/carossoftlight"
                                android:gravity="bottom|center"
                                android:text="@string/v_objekti"
                                android:textColor="?attr/heading_text"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                app:layout_anchor="@+id/frame1"
                                app:layout_anchorGravity="center|center_horizontal|center_vertical"
                                tools:ignore="SmallSp" />
                        </LinearLayout>

                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/frame3"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:translationX="0dp"
                        android:translationY="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            tools:ignore="UselessParent">

                            <ImageButton
                                android:id="@+id/dugme3"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center|top"
                                android:background="@drawable/round_btn"
                                android:backgroundTint="?attr/kategorije_ikonice"
                                android:contentDescription="@string/opis_dugmeta"
                                android:elevation="2dp"
                                android:outlineSpotShadowColor="#00000000"
                                android:padding="5dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/statue"
                                app:layout_anchor="@id/frame_layout"
                                app:layout_anchorGravity="center|center_horizontal|center_vertical"
                                app:tint="@color/primarna" />

                            <TextView
                                android:id="@+id/tekst3"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginTop="5dp"
                                android:autoSizeMaxTextSize="12sp"
                                android:autoSizeMinTextSize="5sp"
                                android:autoSizePresetSizes="12sp"
                                android:fontFamily="@font/carossoftlight"
                                android:gravity="bottom|center"
                                android:text="@string/biste"
                                android:textColor="?attr/heading_text"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                app:layout_anchor="@+id/frame1"
                                app:layout_anchorGravity="bottom|center"
                                tools:ignore="SmallSp" />
                        </LinearLayout>

                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/frame4"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:translationX="0dp"
                        android:translationY="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            tools:ignore="UselessParent">

                            <ImageButton
                                android:id="@+id/dugme4"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center|top"
                                android:background="@drawable/round_btn"
                                android:backgroundTint="?attr/kategorije_ikonice"
                                android:contentDescription="@string/opis_dugmeta"
                                android:elevation="2dp"
                                android:outlineSpotShadowColor="#00000000"
                                android:padding="5dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/mountains"
                                app:layout_anchor="@id/frame_layout"
                                app:layout_anchorGravity="center|top"
                                app:tint="@color/primarna" />

                            <TextView
                                android:id="@+id/tekst4"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginTop="5dp"
                                android:autoSizeMaxTextSize="12sp"
                                android:autoSizeMinTextSize="5sp"
                                android:autoSizePresetSizes="12sp"
                                android:fontFamily="@font/carossoftlight"
                                android:gravity="bottom|center"
                                android:text="@string/priroda"
                                android:textColor="?attr/heading_text"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                app:layout_anchor="@+id/frame1"
                                app:layout_anchorGravity="bottom|center"
                                tools:ignore="SmallSp" />
                        </LinearLayout>

                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/frame5"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:translationX="0dp"
                        android:translationY="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            tools:ignore="UselessParent">

                            <ImageButton
                                android:id="@+id/dugme5"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center|top"
                                android:background="@drawable/round_btn"
                                android:backgroundTint="?attr/kategorije_ikonice"
                                android:contentDescription="@string/opis_dugmeta"
                                android:elevation="2dp"
                                android:outlineSpotShadowColor="#00000000"
                                android:padding="5dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/football_field"
                                app:layout_anchor="@id/frame_layout"
                                app:layout_anchorGravity="center|top"
                                app:tint="@color/primarna" />

                            <TextView
                                android:id="@+id/tekst5"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginTop="5dp"
                                android:autoSizeMaxTextSize="12sp"
                                android:autoSizeMinTextSize="5sp"
                                android:autoSizePresetSizes="12sp"
                                android:fontFamily="@font/carossoftlight"
                                android:gravity="bottom|center"
                                android:text="@string/sport"
                                android:textColor="?attr/heading_text"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                app:layout_anchor="@+id/frame1"
                                app:layout_anchorGravity="bottom|center"
                                tools:ignore="SmallSp" />
                        </LinearLayout>

                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="10dp"
            android:outlineAmbientShadowColor="@android:color/transparent"
            android:translationZ="1dp"
            app:cardBackgroundColor="?attr/kartica_nova"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="30dp"
                android:layout_marginVertical="20dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/kartice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:autoSizeMaxTextSize="20sp"
                    android:autoSizeMinTextSize="14sp"
                    android:fontFamily="@font/carossoft"
                    android:text="@string/izdvojene_lokacije1"
                    android:textColor="?attr/heading_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPager"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:orientation="horizontal" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/frame_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />


    <com.google.android.material.bottomappbar.BottomAppBar
        android:id="@+id/bottomAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@android:color/white"
        android:visibility="invisible"
        app:fabCradleMargin="10dp"
        app:fabCradleRoundedCornerRadius="50dp">

    </com.google.android.material.bottomappbar.BottomAppBar>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_vertical"
        android:layout_marginHorizontal="40dp"
        android:background="@color/white"
        android:visibility="invisible"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>