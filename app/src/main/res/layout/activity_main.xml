<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pozadina"
    tools:context=".MainActivity">
    <FrameLayout
        android:id="@+id/frame_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    
    <!--<com.google.android.material.navigation.NavigationView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:headerLayout="@layout/top_toolbar"
        android:layout_gravity="start"/>Privremeno uklonjen-->

    <com.google.android.material.bottomappbar.BottomAppBar
        android:id="@+id/bottomAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@android:color/transparent"
        android:visibility="invisible"
        app:fabCradleMargin="10dp"
        app:fabCradleRoundedCornerRadius="50dp">

    </com.google.android.material.bottomappbar.BottomAppBar>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="0dp">

        <FrameLayout
            android:layout_width="406dp"
            android:layout_height="128dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginHorizontal="30dp"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="340dp"
                android:layout_height="70dp"
                android:layout_gravity="bottom|center|center_horizontal"
                android:layout_marginBottom="30dp"
                android:background="@drawable/rounded_bottom_navigation_bar"
                android:elevation="8dp"
                android:visibility="visible" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>


    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_vertical"
        android:layout_marginHorizontal="35dp"
        android:layout_marginBottom="25dp"
        android:background="@drawable/rounded_bottom_navigation_bar"
        android:visibility="visible"
        app:labelVisibilityMode="labeled"
        app:layout_anchor="@+id/bottomAppBar"
        app:layout_anchorGravity="center|center_vertical"
        app:menu="@menu/bottom_menu">

    </com.google.android.material.bottomnavigation.BottomNavigationView>

    <TextView
        android:id="@+id/naslov"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:text="TURISTIČKI VODIČ OPŠTINE MILIĆI"
        android:textSize="25dp"
        android:textStyle="bold"
        app:layout_anchor="@+id/frame_layout"
        app:layout_anchorGravity="center"
        android:translationY="-260dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/kartice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="IZDVOJENE LOKACIJE"
        android:fontFamily="sans-serif-condensed"
        android:textSize="20dp"
        android:textStyle="bold"
        app:layout_anchor="@+id/frame_layout"
        app:layout_anchorGravity="center"
        android:translationY="-180dp"
        android:visibility="gone"/>

    <androidx.viewpager2.widget.ViewPager2
        android:layout_width="410dp"
        android:layout_height="210dp"
        app:layout_anchor="@+id/frame_layout"
        app:layout_anchorGravity="center"
        android:translationY="-50dp"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/ikona1"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_anchor="@+id/frame_layout"
        app:layout_anchorGravity="center"
        app:srcCompat="@drawable/baseline_forest_24"
        android:translationY="80dp"
        android:translationX="-155dp"
        android:visibility="gone"/>
    <ImageView
        android:id="@+id/ikona2"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_anchor="@+id/frame_layout"
        app:layout_anchorGravity="center"
        app:srcCompat="@drawable/baseline_local_cafe_24"
        android:translationY="80dp"
        android:translationX="-95dp"
        android:visibility="gone"/>
    <ImageView
        android:id="@+id/ikona3"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_anchor="@+id/frame_layout"
        app:layout_anchorGravity="center"
        app:srcCompat="@drawable/baseline_church_24"
        android:translationY="80dp"
        android:translationX="-35dp"
        android:visibility="gone"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>