<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ARFragment"
    android:layout_marginBottom="130dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/naslovna_linija"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:gravity="center|center_horizontal|center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/Naslov"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:autoSizeMaxTextSize="24sp"
                android:autoSizeMinTextSize="20sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/carossoftbold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="Kamera"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/Podnaslov"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="15sp"
                android:fontFamily="@font/carossoft"
                android:includeFontPadding="false"
                android:text="Proširite realnost"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </LinearLayout>

        <View
            android:id="@+id/divider3"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:background="?android:attr/listDivider" />

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/naslov"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/upit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:autoSizeMaxTextSize="24sp"
            android:fontFamily="@font/carossoftblack"
            android:gravity="center|top"
            android:text="Milići kroz objektiv!?"
            android:textColor="@color/primarna_700"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/upit_text2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:autoSizeMaxTextSize="18sp"
            android:fontFamily="@font/carossoftblack"
            android:gravity="center|top"
            android:text="Šta je to?"
            android:textColor="@color/primarna_700"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tekst"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/button"
        android:layout_below="@id/naslov"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="22dp"
        android:gravity="top"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tuto_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="15sp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp"
                android:fontFamily="@font/carossoftbold"
                android:text="Ova kamera skenira mašine-eksponate muzeja rudarstva na otvorenom u Milićima, ali i druge znamenitosti Milića koji kriju zaboravljene priče, oživljene fragmentima prošlosti.\nOtkrijte ih i upoznajte Miliće
                \n\nŠta mi treba da bih koristio ovu kameru?\n\nSve što trebate je naša aplikacija. Ona sadrži sve što je potrebno za kameru i interakciju sa realnim prostorom.\n\n\nKako mogu da je koristim?\n\n~Klikom na dugme 'Istražite Miliće':\n~Usmjerite kameru ka objektu koji vas zanima, pritisnite dugme za slikanje.\n~Ako se objekat jasno vidi, potvrdite je. Inače, ponovite prethodni korak.\n~Skeniran je? Super! Sada će vam odmah priča biti otkrivena o objektu i prošlosti ovog kraja."
                android:textAlignment="textStart"
                android:textSize="15sp" />
        </ScrollView>


    </LinearLayout>

    <ImageView
        android:id="@+id/menu_heading"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="80dp" />

    <TextView
        android:id="@+id/classified"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/menu_heading"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="0sp"
        android:text="Skenirani objekat je..."
        android:textColor="@color/primarna_700"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/carossoft"
        android:visibility="gone"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_centerHorizontal="true"
        android:text=""
        android:gravity="center"
        android:textColor="@color/primarna_700"
        android:textStyle="bold"
        android:textSize="20sp"
        android:id="@+id/result"
        android:layout_below="@+id/classified"
        android:fontFamily="@font/carossoft"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/confidencesText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/result"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="0sp"
        android:text="Kratka istorija o skeniranom objektu:"
        android:textColor="@color/primarna_700"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/carossoftbold"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_below="@+id/confidencesText"
        android:layout_above="@id/button">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:text=""
        android:textColor="@color/primarna_700"
        android:textSize="15sp"
        android:id="@+id/confidence"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/carossoft"
        android:layout_below="@+id/confidencesText" />

    </ScrollView>

    <Button
        android:id="@+id/button"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:background="@drawable/round_btn"
        android:fontFamily="@font/carossoftbold"
        android:text="Istražite Miliće"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="21sp"
        android:textStyle="bold" />

</RelativeLayout>