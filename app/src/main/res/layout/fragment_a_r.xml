<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ARFragment">

    <ImageView
        android:id="@+id/imageView7"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="100dp"
        android:backgroundTint="?attr/shadow_menu"
        android:visibility="visible"
        app:srcCompat="@drawable/gradient_rectangle"
        android:contentDescription="TODO"
        tools:ignore="ContentDescription,HardcodedText" />

    <ImageView
        android:id="@+id/imageView9"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_alignParentBottom="true"
        app:srcCompat="@drawable/white_rectangle"
        android:contentDescription="TODO"
        tools:ignore="ContentDescription,HardcodedText" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/button"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="20dp">

            <ImageView
                android:id="@+id/menu_heading"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginTop="80dp"
                android:contentDescription="@string/opis_slike" />

            <TextView
                android:id="@+id/classified"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0sp"
                android:layout_gravity="center_horizontal"
                android:fontFamily="@font/carossoft"
                android:text="@string/skenirani_objekat"
                android:textAlignment="center"
                android:textColor="@color/primarna_700"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/result"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:fontFamily="@font/carossoft"
                android:gravity="center"
                android:text=""
                android:textColor="@color/primarna_700"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/confidencesText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0sp"
                android:textAlignment="center"
                android:fontFamily="@font/carossoftbold"
                android:layout_gravity="center_horizontal"
                android:text="@string/kratka_istorija"
                android:textColor="@color/primarna_700"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/confidence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/carossoft"
                android:text=""
                android:textColor="@color/primarna_700"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/naslovna_linija"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:gravity="center|center_horizontal|center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/Naslov"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:autoSizeMaxTextSize="24sp"
                android:autoSizeMinTextSize="20sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/carossoftbold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/kamera"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/Podnaslov"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="15sp"
                android:fontFamily="@font/carossoft"
                android:includeFontPadding="false"
                android:text="@string/prosirite_realnost"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </LinearLayout>

        <View
            android:id="@+id/divider3"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:background="?android:attr/listDivider" />

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/naslov"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/upit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:autoSizeMaxTextSize="24sp"
            android:fontFamily="@font/carossoftblack"
            android:gravity="center|top"
            android:text="@string/objektiv"
            android:textColor="@color/primarna_700"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/upit_text2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:autoSizeMaxTextSize="18sp"
            android:fontFamily="@font/carossoftblack"
            android:gravity="center|top"
            android:text="@string/sta_je_to"
            android:textColor="@color/primarna_700"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tekst"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/button"
        android:layout_below="@id/naslov"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="22dp"
        android:gravity="top"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            tools:ignore="UselessParent">

            <TextView
                android:id="@+id/tuto_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="1sp"
                android:fontFamily="@font/carossoftbold"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp"
                android:text="@string/kamera_opis"
                android:textAlignment="textStart"
                android:textSize="14sp" />
        </ScrollView>


    </LinearLayout>

    <Button
        android:id="@+id/button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="110dp"
        android:backgroundTint="?attr/naslovna_linija"
        android:fontFamily="@font/carossoftbold"
        android:text="@string/istrazite_milice"
        android:textColor="@color/white"
        android:textSize="21sp" />

</RelativeLayout>