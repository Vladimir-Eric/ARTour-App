<!-- styles.xml -->
<resources>

    <!-- Stil za prilagođeni indikator BottomNavigationView -->
    <style name="App.Custom.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/akcent</item>
        <item name="iconTint">@color/white</item>
    </style>

    <!-- Osnovni stil za aplikaciju -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight">
        <!-- Postavke ekrana sa izrezom (notch) -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>

        <!-- Transparentna boja navigacione trake -->
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Transparentna boja statusne trake -->
        <item name="android:statusBarColor">@android:color/transparent</item>

        <!-- Sistemski temni stil za statusnu traku -->
        <item name="android:windowLightStatusBar">false</item>

        <!-- Dodatni stili i postavke prema potrebi -->
    </style>

</resources>