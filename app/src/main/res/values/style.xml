<!-- styles.xml -->
<resources>

    <!-- Osnovni stil za aplikaciju -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight">

        <item name="fragment_pozadina">?attr/fragment_pozadina</item>
        <!-- Ostale postavke stila fragmenta -->
        <item name="naslovna_linija">?attr/naslovna_linija</item>
        <item name="kartica">?attr/kartica</item>
        <item name="heading_text">?attr/heading_text</item>
        <item name="kategorije_ikonice">?attr/kategorije_ikonice</item>
        <item name="slicice">?attr/slicice</item>
        <item name="kartica_nova">?attr/kartica_nova</item>
        <item name="theme_text">?attr/theme_text</item>

        <!-- Tekst font -->
        <item name="fontFamily">@font/carossoft</item>

        <!-- Postavke ekrana sa izrezom (notch) -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>

        <!-- Transparentna boja navigacione trake -->
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Transparentna boja statusne trake -->
        <item name="android:statusBarColor">@android:color/transparent</item>

        <!-- Sistemski temni stil za statusnu traku -->
        <item name="android:windowLightStatusBar">false</item>

        <!-- Dodatni stili i postavke prema potrebi -->
    </style>

    <!-- Stil za prilagođeni indikator BottomNavigationView -->
    <style name="App.Custom.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primarna_900</item>
        <item name="itemTextColor">@color/white</item>

    </style>




</resources>