<!-- night\themes.xml -->
<resources>

    <!-- Base application theme. -->
    <style name="Base.Theme.ARTour" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="fragment_pozadina">@color/dark_blue_theme</item>
        <item name="naslovna_linija">@color/dark_theme_top_menu</item>
        <item name="kartica">@color/dark_theme_card</item>
        <item name="heading_text">@color/dark_theme_text</item>
        <item name="kategorije_ikonice">@color/white_10</item>
        <item name="slicice">@color/primarna_100</item>
        <item name="kartica_nova">@color/dark_kartica</item>
        <item name="theme_text">@color/white</item>
        <item name="theme_text_ghost">@color/ghost_white</item>
        <item name="nav_meni">@color/dark_theme_top_menu</item>
        <item name="shadow_menu">@color/dark_blue_theme</item>

        <item name="menu_heading_card">@color/dark_blue_theme</item>
        <item name="handle">#0d264d</item>

        <!-- Optional: set to transparent if your app is drawing behind the status bar. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@color/dark_theme_top_menu</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="BottomNavStyle" parent="Widget.Design.BottomNavigationView">
        <item name="fontFamily">@font/carossoftextrabold</item>
        <!-- Dodajte ostale stilove prema vašim potrebama -->
    </style>

    <style name="Theme.ARTour" parent="Base.Theme.ARTour">
        <!-- Transparent system bars for edge-to-edge. -->
        <!--
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@color/dark_theme</item>
        <item name="android:windowLightStatusBar">false</item>
        -->
    </style>

</resources>